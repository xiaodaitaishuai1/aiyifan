<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_page" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="@dimen/dp_24">
        <com.aiyifan.app.feature.mine.HeaderGestureLayout android:id="@+id/mineHeader" android:layout_width="match_parent" android:layout_height="@dimen/mine_header_height" android:background="@color/page_bg" android:clipChildren="true" android:clipToPadding="true">
            <com.aiyifan.app.feature.mine.HeaderSlideView android:id="@+id/headerImage" android:layout_width="match_parent" android:layout_height="match_parent" android:clickable="false" android:focusable="false" android:importantForAccessibility="no" />
            <com.aiyifan.app.feature.mine.HeaderSlideView android:id="@+id/headerNextImage" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="invisible" android:clickable="false" android:focusable="false" android:importantForAccessibility="no" />
            <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#CC000000" android:importantForAccessibility="no" />
            <View android:layout_width="match_parent" android:layout_height="@dimen/dp_80" android:layout_gravity="bottom" android:background="@drawable/bg_mine_header_fade" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:layout_margin="@dimen/dp_16" android:orientation="horizontal">
                <ImageButton android:id="@+id/headerPlayback" android:layout_width="@dimen/dp_48" android:layout_height="@dimen/dp_48" android:padding="@dimen/dp_12" android:background="@drawable/bg_mine_header_control" android:src="@drawable/ic_pause" android:contentDescription="@string/mine_pause_slideshow" app:tint="#FFFFFFFF" />
                <ImageButton android:id="@+id/headerExpand" android:layout_width="@dimen/dp_48" android:layout_height="@dimen/dp_48" android:layout_marginStart="@dimen/dp_8" android:padding="@dimen/dp_12" android:background="@drawable/bg_mine_header_control" android:src="@drawable/ic_fullscreen" android:contentDescription="@string/mine_view_image" app:tint="#FFFFFFFF" />
            </LinearLayout>
        </com.aiyifan.app.feature.mine.HeaderGestureLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/dp_16" android:layout_marginTop="@dimen/dp_16" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="@dimen/dp_6" android:layout_weight="1" android:background="@drawable/bg_mine_stat" android:orientation="vertical" android:padding="@dimen/dp_16">
                <TextView android:id="@+id/historyCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/text_primary" android:textSize="@dimen/sp_22" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_4" android:text="@string/mine_history_count" android:textColor="@color/text_secondary" android:textSize="@dimen/sp_12" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/dp_6" android:layout_weight="1" android:background="@drawable/bg_mine_stat" android:orientation="vertical" android:padding="@dimen/dp_16">
                <TextView android:id="@+id/favoriteCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/text_primary" android:textSize="@dimen/sp_22" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_4" android:text="@string/mine_favorite_count" android:textColor="@color/text_secondary" android:textSize="@dimen/sp_12" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/dp_20" android:layout_marginTop="@dimen/dp_24" android:layout_marginBottom="@dimen/dp_8" android:text="@string/mine_common_features" android:textColor="@color/text_secondary" android:textSize="@dimen/sp_13" />
        <LinearLayout android:id="@+id/contentGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/dp_16" android:background="@drawable/bg_surface" android:orientation="vertical" android:paddingHorizontal="@dimen/dp_8" android:paddingVertical="@dimen/dp_6">
            <LinearLayout android:id="@+id/historyButton" style="@style/MineActionRow" android:contentDescription="@string/hardcoded_text_040"><ImageView style="@style/MineActionIcon" android:contentDescription="@string/hardcoded_text_039" android:src="@drawable/ic_history" /><LinearLayout style="@style/MineActionTextGroup"><TextView style="@style/MineActionTitle" android:text="@string/hardcoded_text_039" /><TextView style="@style/MineActionSubtitle" android:text="@string/mine_history_subtitle" /></LinearLayout><ImageView style="@style/MineActionArrow" android:contentDescription="@string/hardcoded_text_040" android:src="@drawable/ic_chevron_right" /></LinearLayout>
            <LinearLayout android:id="@+id/collectionButton" style="@style/MineActionRow" android:contentDescription="@string/hardcoded_text_042"><ImageView style="@style/MineActionIcon" android:contentDescription="@string/hardcoded_text_041" android:src="@drawable/ic_favorite" /><LinearLayout style="@style/MineActionTextGroup"><TextView style="@style/MineActionTitle" android:text="@string/hardcoded_text_041" /><TextView style="@style/MineActionSubtitle" android:text="@string/mine_favorite_subtitle" /></LinearLayout><ImageView style="@style/MineActionArrow" android:contentDescription="@string/hardcoded_text_042" android:src="@drawable/ic_chevron_right" /></LinearLayout>
            <LinearLayout android:id="@+id/hotButton" style="@style/MineActionRow" android:contentDescription="@string/tab_hot"><ImageView style="@style/MineActionIcon" android:contentDescription="@string/tab_hot" android:src="@drawable/ic_favorite" /><LinearLayout style="@style/MineActionTextGroup"><TextView style="@style/MineActionTitle" android:text="@string/tab_hot" /><TextView style="@style/MineActionSubtitle" android:text="@string/mine_hot_subtitle" /></LinearLayout><ImageView style="@style/MineActionArrow" android:contentDescription="@string/tab_hot" android:src="@drawable/ic_chevron_right" /></LinearLayout>
            <LinearLayout android:id="@+id/localMediaButton" style="@style/MineActionRow" android:contentDescription="@string/local_media_title"><ImageView style="@style/MineActionIcon" android:contentDescription="@string/local_media_title" android:src="@drawable/ic_play" app:tint="@color/accent" /><LinearLayout style="@style/MineActionTextGroup"><TextView style="@style/MineActionTitle" android:text="@string/local_media_title" /><TextView style="@style/MineActionSubtitle" android:text="@string/mine_local_media_subtitle" /></LinearLayout><ImageView style="@style/MineActionArrow" android:contentDescription="@string/local_media_title" android:src="@drawable/ic_chevron_right" /></LinearLayout>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/dp_20" android:layout_marginTop="@dimen/dp_24" android:layout_marginBottom="@dimen/dp_8" android:text="@string/hardcoded_text_043" android:textColor="@color/text_secondary" android:textSize="@dimen/sp_13" />
        <LinearLayout android:id="@+id/settingsGroup" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/dp_16" android:background="@drawable/bg_surface" android:paddingHorizontal="@dimen/dp_8" android:paddingVertical="@dimen/dp_6"><LinearLayout android:id="@+id/themeSettingsButton" style="@style/MineActionRow" android:contentDescription="@string/enter_theme_settings" android:paddingHorizontal="@dimen/dp_12"><ImageView style="@style/MineActionIcon" android:contentDescription="@string/theme_settings_title" android:src="@drawable/ic_theme" /><LinearLayout style="@style/MineActionTextGroup"><TextView style="@style/MineActionTitle" android:text="@string/theme_settings_title" /><TextView android:id="@+id/themeSettingsSummary" style="@style/MineActionSubtitle" /></LinearLayout><ImageView style="@style/MineActionArrow" android:contentDescription="@string/enter_theme_settings" android:src="@drawable/ic_chevron_right" /></LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
