<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_page">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">

        <LinearLayout android:id="@+id/topBar" android:layout_width="match_parent" android:layout_height="@dimen/dp_56" android:background="@color/surface" android:gravity="center_vertical" android:orientation="horizontal">

            <ImageButton android:id="@+id/backButton" android:layout_width="@dimen/dp_56" android:layout_height="match_parent" android:background="@android:color/transparent" android:contentDescription="@string/hardcoded_text_001" android:gravity="center" android:padding="@dimen/dp_16" android:src="@drawable/ic_back" />

            <TextView android:id="@+id/title" android:layout_width="@dimen/dp_0" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:textColor="@color/text_primary" android:textSize="@dimen/sp_20" android:textStyle="bold" />

            <TextView android:id="@+id/actionButton" android:layout_width="@dimen/dp_72" android:layout_height="match_parent" android:gravity="center" android:textColor="@color/text_secondary" android:textSize="@dimen/sp_13" />
        </LinearLayout>

        <FrameLayout android:layout_width="match_parent" android:layout_height="@dimen/dp_0" android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:padding="@dimen/dp_12" />

            <LinearLayout android:id="@+id/emptyState" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="@dimen/dp_24" android:visibility="gone">

                <ImageView android:id="@+id/emptyArtwork" android:layout_width="@dimen/dp_120" android:layout_height="@dimen/dp_120" android:contentDescription="@string/hardcoded_text_021" android:src="@drawable/ic_empty_history" />

                <TextView android:id="@+id/emptyView" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_16" android:gravity="center" android:textColor="@color/text_secondary" android:textSize="@dimen/sp_15" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
