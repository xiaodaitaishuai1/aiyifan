<?xml version="1.0" encoding="utf-8"?>
<com.aiyifan.app.feature.video.ResizablePlayerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_floating_player" android:clipToOutline="true">

    <!-- Keep video in the same composition layer as the resizable, clipped overlay window. -->
    <androidx.media3.ui.PlayerView android:id="@+id/floatingPlayerView" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/black" app:surface_type="texture_view" app:show_buffering="when_playing" app:shutter_background_color="@android:color/black" app:use_controller="false" />

    <TextView android:id="@+id/floatingSleepTimerButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_gravity="top|start" android:paddingHorizontal="8dp" android:gravity="center" android:background="@drawable/bg_floating_control" android:text="@string/sleep_timer_title" android:textColor="@android:color/white" android:textSize="12sp" />

    <ImageButton android:id="@+id/floatingCloseButton" android:layout_width="@dimen/dp_36" android:layout_height="@dimen/dp_36" android:layout_gravity="top|end" android:layout_margin="@dimen/dp_6" android:background="@drawable/bg_floating_control" android:contentDescription="@string/hardcoded_text_047" android:padding="@dimen/dp_6" android:src="@drawable/ic_close" />

    <LinearLayout android:id="@+id/floatingPlaybackControls" android:layout_width="match_parent" android:layout_height="@dimen/dp_40" android:layout_gravity="center" android:paddingHorizontal="@dimen/dp_4" android:gravity="center" android:orientation="horizontal">

        <ImageButton android:id="@+id/floatingRewindButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="@dimen/dp_40" android:layout_marginHorizontal="@dimen/dp_4" android:background="@android:color/transparent" android:contentDescription="@string/player_rewind_ten_seconds" android:padding="@dimen/dp_8" android:src="@drawable/ic_replay_10" app:tint="@android:color/white" />

        <ImageButton android:id="@+id/floatingPlayPauseButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="@dimen/dp_40" android:background="@android:color/transparent" android:contentDescription="@string/hardcoded_text_031" android:padding="@dimen/dp_8" android:src="@drawable/ic_pause" />

        <ImageButton android:id="@+id/floatingForwardButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="@dimen/dp_40" android:layout_marginHorizontal="@dimen/dp_4" android:background="@android:color/transparent" android:contentDescription="@string/player_forward_ten_seconds" android:padding="@dimen/dp_8" android:src="@drawable/ic_forward_10" app:tint="@android:color/white" />

    </LinearLayout>

    <ImageButton android:id="@+id/floatingResizeHandle" android:layout_width="@dimen/dp_32" android:layout_height="@dimen/dp_24" android:layout_gravity="bottom|end" android:background="@android:color/transparent" android:contentDescription="@string/hardcoded_text_032" android:padding="@dimen/dp_2" android:src="@drawable/ic_resize" />

    <ImageButton android:id="@+id/floatingRestoreHandle" android:layout_width="@dimen/dp_24" android:layout_height="match_parent" android:layout_gravity="start|center_vertical" android:background="@android:color/black" android:contentDescription="@string/floating_player_restore" android:src="@drawable/ic_back" app:tint="@android:color/white" android:visibility="gone" />
</com.aiyifan.app.feature.video.ResizablePlayerLayout>
