<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp_12"
    android:background="@drawable/bg_surface"
    android:orientation="horizontal"
    android:padding="@dimen/dp_10">

    <FrameLayout
        android:layout_width="@dimen/dp_120"
        android:layout_height="@dimen/dp_72"
        android:layout_gravity="center_vertical">

        <ImageView
            android:id="@+id/localPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_poster"
            android:clipToOutline="true"
            android:contentDescription="@string/video_poster"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_96"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/localTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/sp_16"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/localMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/sp_12" />

        <Space
            android:layout_width="@dimen/dp_1"
            android:layout_height="@dimen/dp_0"
            android:layout_weight="1" />

        <Button
            android:id="@+id/localPlayButton"
            android:layout_width="@dimen/dp_120"
            android:layout_height="@dimen/dp_44"
            android:background="@drawable/bg_button_primary"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/local_media_play"
            android:textColor="@color/text_on_accent"
            app:backgroundTint="@null" />
    </LinearLayout>
</LinearLayout>
